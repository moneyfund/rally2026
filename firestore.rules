rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || request.auth.token.email == 'norvingarcia220@gmail.com'
      );
    }

    function isLegacyPublicProfile() {
      return ('createdAt' in resource.data)
        && resource.data.createdAt < timestamp.value(1787957460000);
    }

    function validProfileKind() {
      return request.resource.data.kind == 'persona'
        || request.resource.data.kind == 'negocio'
        || request.resource.data.kind == 'empresa';
    }

    function validLocationConsent() {
      return !('coordinates' in request.resource.data)
        || request.resource.data.coordinates == null
        || (
          ('locationPublic' in request.resource.data)
          && request.resource.data.locationPublic == true
        )
        || (
          !('locationPublic' in request.resource.data)
          && request.resource.data.kind == 'negocio'
        );
    }

    function adminProfileFieldsUnchanged() {
      return request.resource.data.verified == resource.data.verified
        && request.resource.data.get('verificationStatus', 'pending') == resource.data.get('verificationStatus', 'pending')
        && request.resource.data.get('verificationNote', '') == resource.data.get('verificationNote', '')
        && request.resource.data.get('verificationReviewedAt', null) == resource.data.get('verificationReviewedAt', null)
        && request.resource.data.get('verificationReviewedBy', '') == resource.data.get('verificationReviewedBy', '')
        && request.resource.data.get('partner', false) == resource.data.get('partner', false)
        && request.resource.data.get('partnerSince', null) == resource.data.get('partnerSince', null);
    }

    function approvedCompany(uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid))
        && get(/databases/$(database)/documents/profiles/$(uid)).data.kind == 'empresa'
        && get(/databases/$(database)/documents/profiles/$(uid)).data.verified == true
        && get(/databases/$(database)/documents/profiles/$(uid)).data.verificationStatus == 'approved';
    }

    match /users/{uid} {
      allow read: if owns(uid) || isAdmin();

      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'accountType', 'createdAt', 'updatedAt'
        ]);

      allow update: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'accountType', 'createdAt', 'updatedAt'
        ]);

      allow delete: if owns(uid);

      match /legalDocuments/{documentId} {
        allow read: if owns(uid) || isAdmin();
        allow create, update, delete: if owns(uid);
      }

      match /privateLocation/{documentId} {
        allow read: if owns(uid) || isAdmin();
        allow create, update, delete: if owns(uid) || isAdmin();
      }
    }

    match /{path=**}/legalDocuments/{documentId} {
      allow read: if isAdmin();
    }

    match /profiles/{uid} {
      allow read: if isAdmin()
        || owns(uid)
        || resource.data.verified == true
        || isLegacyPublicProfile();

      allow create: if owns(uid)
        && request.resource.data.ownerId == uid
        && request.resource.data.verified == false
        && request.resource.data.get('verificationStatus', 'pending') == 'pending'
        && request.resource.data.get('verificationNote', '') == ''
        && request.resource.data.get('partner', false) == false
        && validProfileKind()
        && validLocationConsent()
        && request.resource.data.keys().hasOnly([
          'ownerId', 'kind', 'name', 'legalName', 'companyEmail', 'website',
          'representativeName', 'representativeRole', 'category', 'profession',
          'headline', 'description', 'location', 'coordinates', 'locationPublic',
          'phone', 'socialLinks', 'services', 'skills', 'avatarUrl',
          'googlePhotoUrl', 'coverUrl', 'portfolio', 'available', 'verified',
          'status', 'verificationStatus', 'verificationNote',
          'verificationReviewedAt', 'verificationReviewedBy', 'partner',
          'partnerSince', 'createdAt', 'updatedAt'
        ]);

      allow update: if (
        isAdmin()
        && validProfileKind()
        && validLocationConsent()
      ) || (
        owns(uid)
        && resource.data.ownerId == uid
        && request.resource.data.ownerId == uid
        && request.resource.data.ownerId == resource.data.ownerId
        && adminProfileFieldsUnchanged()
        && validProfileKind()
        && validLocationConsent()
        && request.resource.data.keys().hasOnly([
          'ownerId', 'kind', 'name', 'legalName', 'companyEmail', 'website',
          'representativeName', 'representativeRole', 'category', 'profession',
          'headline', 'description', 'location', 'coordinates', 'locationPublic',
          'phone', 'socialLinks', 'services', 'skills', 'avatarUrl',
          'googlePhotoUrl', 'coverUrl', 'portfolio', 'available', 'verified',
          'status', 'verificationStatus', 'verificationNote',
          'verificationReviewedAt', 'verificationReviewedBy', 'partner',
          'partnerSince', 'createdAt', 'updatedAt'
        ])
      );

      allow delete: if owns(uid) || isAdmin();
    }

    match /jobPosts/{jobId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.companyId == request.auth.uid)
        || resource.data.status == 'active';

      allow create: if signedIn()
        && request.resource.data.companyId == request.auth.uid
        && approvedCompany(request.auth.uid)
        && request.resource.data.status == 'active'
        && request.resource.data.featured == false
        && request.resource.data.keys().hasOnly([
          'companyId', 'companyName', 'companyLogo', 'title', 'category',
          'modality', 'location', 'jobType', 'salary', 'description',
          'requirements', 'benefits', 'status', 'featured', 'publishedAt',
          'createdAt', 'updatedAt'
        ]);

      allow update: if isAdmin() || (
        signedIn()
        && resource.data.companyId == request.auth.uid
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.featured == resource.data.featured
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
          'companyId', 'companyName', 'companyLogo', 'title', 'category',
          'modality', 'location', 'jobType', 'salary', 'description',
          'requirements', 'benefits', 'status', 'featured', 'publishedAt',
          'createdAt', 'updatedAt'
        ])
      );

      allow delete: if isAdmin()
        || (signedIn() && resource.data.companyId == request.auth.uid);

      match /applications/{applicationId} {
        allow read: if isAdmin()
          || (signedIn() && resource.data.applicantId == request.auth.uid)
          || (signedIn() && resource.data.companyId == request.auth.uid);

        allow create: if signedIn()
          && request.resource.data.applicantId == request.auth.uid
          && request.resource.data.applicantProfileId == request.auth.uid
          && request.resource.data.jobId == jobId
          && get(/databases/$(database)/documents/jobPosts/$(jobId)).data.status == 'active'
          && request.resource.data.companyId == get(/databases/$(database)/documents/jobPosts/$(jobId)).data.companyId
          && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.kind != 'empresa'
          && request.resource.data.status == 'sent'
          && request.resource.data.keys().hasOnly([
            'jobId', 'jobTitle', 'companyId', 'applicantId', 'applicantName',
            'applicantEmail', 'applicantPhone', 'applicantProfileId', 'message',
            'status', 'createdAt'
          ]);

        allow update: if isAdmin() || (
          signedIn()
          && resource.data.companyId == request.auth.uid
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.applicantId == resource.data.applicantId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        );

        allow delete: if isAdmin()
          || (signedIn() && resource.data.companyId == request.auth.uid)
          || (signedIn() && resource.data.applicantId == request.auth.uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
