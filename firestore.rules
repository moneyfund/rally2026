rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || request.auth.token.email == 'norvingarcia220@gmail.com'
      );
    }

    function validProfileKind() {
      return request.resource.data.kind == 'persona'
        || request.resource.data.kind == 'negocio';
    }

    function validLocationConsent() {
      return !('coordinates' in request.resource.data)
        || request.resource.data.coordinates == null
        || (
          ('locationPublic' in request.resource.data)
          && request.resource.data.locationPublic == true
        )
        || (
          !('locationPublic' in request.resource.data)
          && request.resource.data.kind == 'negocio'
        );
    }

    function adminProfileFieldsUnchanged() {
      return request.resource.data.verified == resource.data.verified
        && request.resource.data.get('verificationStatus', 'pending') == resource.data.get('verificationStatus', 'pending')
        && request.resource.data.get('verificationNote', '') == resource.data.get('verificationNote', '')
        && request.resource.data.get('verificationReviewedAt', null) == resource.data.get('verificationReviewedAt', null)
        && request.resource.data.get('verificationReviewedBy', '') == resource.data.get('verificationReviewedBy', '')
        && request.resource.data.get('partner', false) == resource.data.get('partner', false)
        && request.resource.data.get('partnerSince', null) == resource.data.get('partnerSince', null);
    }

    match /users/{uid} {
      allow read: if owns(uid) || isAdmin();

      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'accountType', 'createdAt', 'updatedAt'
        ]);

      allow update: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'accountType', 'createdAt', 'updatedAt'
        ]);

      allow delete: if owns(uid);

      match /legalDocuments/{documentId} {
        allow read: if owns(uid) || isAdmin();
        allow create, update, delete: if owns(uid);
      }

      match /privateLocation/{documentId} {
        allow read: if owns(uid) || isAdmin();
        allow create, update, delete: if owns(uid) || isAdmin();
      }
    }

    match /{path=**}/legalDocuments/{documentId} {
      allow read: if isAdmin();
    }

    match /profiles/{uid} {
      allow read: if isAdmin() || owns(uid) || resource.data.verified == true;

      allow create: if owns(uid)
        && request.resource.data.ownerId == uid
        && request.resource.data.verified == false
        && request.resource.data.get('verificationStatus', 'pending') == 'pending'
        && request.resource.data.get('verificationNote', '') == ''
        && request.resource.data.get('partner', false) == false
        && validProfileKind()
        && validLocationConsent()
        && request.resource.data.keys().hasOnly([
          'ownerId', 'kind', 'name', 'category', 'profession', 'headline',
          'description', 'location', 'coordinates', 'locationPublic', 'phone',
          'socialLinks', 'services', 'skills', 'avatarUrl', 'googlePhotoUrl',
          'coverUrl', 'portfolio', 'available', 'verified', 'status',
          'verificationStatus', 'verificationNote', 'verificationReviewedAt',
          'verificationReviewedBy', 'partner', 'partnerSince',
          'createdAt', 'updatedAt'
        ]);

      allow update: if (
        isAdmin()
        && validProfileKind()
        && validLocationConsent()
      ) || (
        owns(uid)
        && resource.data.ownerId == uid
        && request.resource.data.ownerId == uid
        && request.resource.data.ownerId == resource.data.ownerId
        && adminProfileFieldsUnchanged()
        && validProfileKind()
        && validLocationConsent()
        && request.resource.data.keys().hasOnly([
          'ownerId', 'kind', 'name', 'category', 'profession', 'headline',
          'description', 'location', 'coordinates', 'locationPublic', 'phone',
          'socialLinks', 'services', 'skills', 'avatarUrl', 'googlePhotoUrl',
          'coverUrl', 'portfolio', 'available', 'verified', 'status',
          'verificationStatus', 'verificationNote', 'verificationReviewedAt',
          'verificationReviewedBy', 'partner', 'partnerSince',
          'createdAt', 'updatedAt'
        ])
      );

      allow delete: if owns(uid) || isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
